ANTHROPIC_API_KEY=
FAL_API_KEY=
ELEVENLABS_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STUDIO=
SUPABASE_URL=
SUPABASE_ANON_KEY=          # safe for browser
SUPABASE_SERVICE_ROLE_KEY=  # serverless only, NEVER shipped to browser
APP_URL=
SENTRY_DSN=

# Browser-exposed copies (Vite only ships VITE_-prefixed vars to the client
# bundle). Same values as SUPABASE_URL / SUPABASE_ANON_KEY above.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SENTRY_DSN=

# Phase 1:
# - ANTHROPIC_API_KEY is required to run /api/territory.
# - ANTHROPIC_MODEL overrides the default territory-generation model (optional).
# - GENERATION_ENABLED=false is a global kill switch for /api/territory.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
GENERATION_ENABLED=true

# Phase 2:
# - SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY and their
#   VITE_ copies above are required for auth + persistence.
# - Run supabase/migrations/0001_projects_territories.sql in the Supabase
#   SQL Editor before using the app.

# Phase 4:
# - FAL_API_KEY is required for /api/panel.
# - FAL_MODEL_* override the default fal.ai model ids (optional).
# - Run migrations 0002-0005 and create the "references"/"panels" Storage
#   buckets (see README) before generating look profiles or panels.
FAL_MODEL_TEXT_TO_IMAGE=fal-ai/flux/dev
FAL_MODEL_WITH_REFERENCE=fal-ai/flux-pro/kontext/multi
FAL_MODEL_QUALITY=fal-ai/nano-banana-pro/edit

# Phase 5:
# - ELEVENLABS_API_KEY is required for /api/vo.
# - ELEVENLABS_VOICE_ID / ELEVENLABS_MODEL_ID override the default voice/model
#   (optional). The default must be one of the account's own premade voices —
#   shared "voice library" voices (e.g. the commonly-referenced "Rachel")
#   return 402 payment_required on free-tier accounts. Voice/model current
#   as of the American-accent shortlist rebuild (see README).
# - Run migration 0006 before generating a voiceover.
ELEVENLABS_VOICE_ID=cjVigY5qzO86Huf0OWal
ELEVENLABS_MODEL_ID=eleven_v3

# Phase 6:
# - STRIPE_SECRET_KEY / STRIPE_PRICE_ID_STUDIO are required for /api/checkout
#   and /api/billing-portal. Create one Stripe product with a single
#   recurring $29/mo price in test mode, then copy that price's id here.
# - STRIPE_WEBHOOK_SECRET is required for /api/stripe-webhook. Locally, run
#   `stripe listen --forward-to localhost:5173/api/stripe-webhook` (Stripe
#   CLI) — it prints a webhook signing secret starting with whsec_, use
#   that here. In production, create a webhook endpoint in the Stripe
#   Dashboard pointed at https://<your-domain>/api/stripe-webhook,
#   subscribed to checkout.session.completed, customer.subscription.updated,
#   customer.subscription.deleted, and invoice.payment_failed — that
#   endpoint has its own separate signing secret.
# - APP_URL must be set (e.g. http://localhost:5173 locally) — Checkout's
#   success/cancel URLs and the billing portal's return_url are built from
#   it.
# - Run migration 0011 before subscribing.

# Phase 7:
# - SENTRY_DSN / VITE_SENTRY_DSN are optional. Every /api/* route and the
#   client's top-level ErrorBoundary already call into Sentry, but it's a
#   safe no-op until these are set — nothing breaks if you leave them blank.
#   Create a free project at sentry.io (JavaScript/React platform), copy its
#   DSN into both vars (same value works for both client and server; a real
#   DSN is safe to expose client-side by design, unlike the other keys
#   above — it can only submit events, not read your account).
